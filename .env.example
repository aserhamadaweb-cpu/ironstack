# Public (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Canonical site origin for auth OAuth / password-reset redirects (set in Vercel too).
# Example production: https://ironstack.vercel.app
# Example local: http://localhost:3000
# Browser auth prefers window.location.origin when available.
NEXT_PUBLIC_SITE_URL=

# Supabase Dashboard → Authentication → Providers → Email:
#   Confirm email = OFF  (mailer_autoconfirm = true) so sign-up returns a session immediately.
# Custom SMTP (optional): npm run configure:smtp — add --autoconfirm to enforce instant sign-up.
# Redirect URLs must include /auth/callback on each origin, e.g.:
#   http://localhost:3000/auth/callback
#   https://YOUR_PRODUCTION_DOMAIN/auth/callback

# Server-only (never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.1-flash-lite-preview in lib/ai/prompt.ts
GEMINI_MODEL=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@ironstack.app
PUSH_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Scripts / local audit tooling only (optional)
APP_ORIGIN=http://localhost:3000
