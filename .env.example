# =============================================================================
# IRONSTACK — Environment variables (.env.example)
# Copy to .env.local for local dev. Set the same keys in Vercel → Settings →
# Environment Variables (Production + Preview).
# =============================================================================

# --- Public (safe in browser bundles) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Canonical production origin (required on Vercel Production).
# Example: https://iron-stack.vercel.app or your custom domain.
# Used for password-reset emails, OAuth redirects, and absolute share links.
# Preview deploys fall back to https://$VERCEL_URL when this is unset.
NEXT_PUBLIC_SITE_URL=

# Google Web Client ID (OAuth 2.0 Client ID of type "Web application").
# Required for Google sign-in inside the installed PWA (no Safari redirect).
# Same Client ID configured in Supabase → Auth → Providers → Google.
# Also add it under "Authorized Client IDs" and enable "Skip nonce check".
# IMPORTANT: Do NOT mark this as Sensitive on Vercel — NEXT_PUBLIC_* values are
# inlined at build time; Sensitive placeholders (e.g. "y") break Google login.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.1-flash-lite-preview in lib/ai/prompt.ts
GEMINI_MODEL=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@ironstack.app
PUSH_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Required on Vercel so the daily training-reminder cron can run.
# Vercel sends it as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# --- Scripts / local audit tooling only (optional; not needed on Vercel) ---
APP_ORIGIN=http://localhost:3000

# =============================================================================
# Vercel deployment checklist
# =============================================================================
# 1. Connect this repo in Vercel (project: iron-stack) or run: vercel --prod
# 2. Build command is `npm run build` (uses webpack for PWA/service worker)
# 3. Set all env vars above in Vercel for Production (and Preview if testing auth)
# 4. Set NEXT_PUBLIC_SITE_URL to your production URL on the Production env only
# 5. Supabase Dashboard → Authentication → URL Configuration:
#      Site URL: https://YOUR_PRODUCTION_DOMAIN
#      Redirect URLs (add each origin you use):
#        https://YOUR_PRODUCTION_DOMAIN/auth/callback
#        https://YOUR_PRODUCTION_DOMAIN/auth/oauth-return
#        https://YOUR_PRODUCTION_DOMAIN/auth/finalize
#        https://YOUR-PROJECT.vercel.app/auth/callback   (optional, for previews)
# 5b. Supabase → Authentication → Providers → Google:
#      Authorized Client IDs: paste your Google Web Client ID
#      Enable "Skip nonce check"
#      Set NEXT_PUBLIC_GOOGLE_CLIENT_ID to that same Web Client ID on Vercel
# 6. Supabase → Authentication → Providers → Email:
#      Confirm email = OFF (instant sign-up session) unless you want email confirm
# 7. Apply SQL migrations in supabase/*.sql not yet run on your project
# 8. Redeploy after changing environment variables
